# Dependências do Node.js
node_modules/

# Arquivos de ambiente
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache
.DS_Store
.vscode/
dist/
build/
